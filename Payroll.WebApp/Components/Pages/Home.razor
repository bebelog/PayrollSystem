    private PayrollPeriod? _latestPeriod;
    private List<PayrollPeriod> _periods = new();

    private Timesheet? _myTimesheet;
    private Payslip? _latestPayslip;

    private TimesheetEntry? _todayEntry;
    private bool _isSubmitting;
    private string? _successMessage;
    private string? _errorMessage;

    // Custom Time Mode for Demo / Simulation
    private bool _isCustomTimeMode = false;
    private TimeOnly _customCheckInTime = new TimeOnly(8, 0);
    private TimeOnly _customCheckOutTime = new TimeOnly(17, 0);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            _currentUserName = user.Identity.Name ?? "";
            _isAccountant = user.IsInRole("Accountant");

            var empIdClaim = user.FindFirst("EmployeeId");
            if (empIdClaim != null && int.TryParse(empIdClaim.Value, out int empId))
            {
                _currentEmployeeId = empId;
                _currentEmployee = await GetEmployeeByIdUseCase.ExecuteAsync(empId);
            }

            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            var allPeriods = (await ViewPayrollPeriodsUseCase.ExecuteAsync()).ToList();
            _periods = allPeriods;
            _latestPeriod = allPeriods.FirstOrDefault();

            if (_isAccountant)
            {
                var employees = await ViewEmployeesUseCase.ExecuteAsync();
                _employeeCount = employees.Count();

                int curMonth = _latestPeriod?.Month ?? DateTime.Today.Month;
                int curYear = _latestPeriod?.Year ?? DateTime.Today.Year;
                var timesheets = await ViewAllTimesheetsUseCase.ExecuteAsync(curMonth, curYear);
                _pendingTimesheetCount = timesheets.Count(t => t.Status == TimesheetStatus.Submitted);
            }
            else if (_currentEmployeeId.HasValue)
            {
                int empId = _currentEmployeeId.Value;
                int curMonth = DateTime.Today.Month;
                int curYear = DateTime.Today.Year;

                _myTimesheet = await ViewMyTimesheetUseCase.ExecuteAsync(empId, UserRole.Employee, empId, curMonth, curYear);
                if (_myTimesheet != null)
                {
                    _todayEntry = _myTimesheet.Entries.FirstOrDefault(e => e.WorkDate.Date == DateTime.Today);
                    if (_todayEntry != null && _todayEntry.CheckInTime.HasValue)
                    {
                        _customCheckInTime = TimeOnly.FromDateTime(_todayEntry.CheckInTime.Value);
                    }
                    if (_todayEntry != null && _todayEntry.CheckOutTime.HasValue)
                    {
                        _customCheckOutTime = TimeOnly.FromDateTime(_todayEntry.CheckOutTime.Value);
                    }
                }

                // Find latest period with actual payslip
                foreach (var p in _periods.OrderByDescending(p => p.Year).ThenByDescending(p => p.Month))
                {
                    var slip = await ViewMyPayslipUseCase.ExecuteAsync(empId, UserRole.Employee, empId, p.PeriodId);
                    if (slip != null)
                    {
                        _latestPayslip = slip;
                        _latestPeriod = p;
                        break;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void SetPresetShift(int inH, int inM, int outH, int outM)
    {
        _customCheckInTime = new TimeOnly(inH, inM);
        _customCheckOutTime = new TimeOnly(outH, outM);
        _isCustomTimeMode = true;
    }

