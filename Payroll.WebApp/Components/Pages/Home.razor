        _isSubmitting = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var entry = await RecordAttendanceTodayUseCase.RecordShiftTodayAsync(
                _currentEmployeeId.Value, 
                _customCheckInTime.ToTimeSpan(), 
                _customCheckOutTime.ToTimeSpan()
            );

            _successMessage = $"LÆ°u ca lÃ m viá»‡c hÃ´m nay thÃ nh cÃ´ng! VÃ o: {_customCheckInTime:HH:mm} | Ra: {_customCheckOutTime:HH:mm} ({entry.WorkingHours}h cÃ´ng).";
            _isCustomTimeMode = false;
            await LoadDataAsync();
        }
        catch (BusinessRuleException brex)
        {
            _errorMessage = brex.Message;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Lá»—i há»‡ thá»‘ng: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

